# -----------------------------------------------------------------------------
# Styly Admin Dashboard - Environment Configuration Template
# -----------------------------------------------------------------------------
# All variables are optional for production when served same-origin behind nginx.
# Set these during local development or when proxying to a remote backend.
# -----------------------------------------------------------------------------

# Backend API proxy target for Vite dev server (defaults to http://127.0.0.1:4000)
VITE_API_PROXY_TARGET=http://127.0.0.1:4000

# Base URL for REST API calls (leave empty when served same-origin behind reverse proxy)
VITE_API_BASE_URL=

# Umami Analytics Endpoint (optional telemetry, leave disabled or empty to disable)
VITE_ANALYTICS_ENDPOINT=

# Umami Analytics Website ID (optional telemetry ID)
VITE_ANALYTICS_WEBSITE_ID=
